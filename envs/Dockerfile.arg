## Local ARG inference and dating (tsinfer + tsdate) for scripts/sv_age_arg.py, plus
## bcftools for pulling regions out of gs:// VCFs without localizing them. Debian's
## htslib is built with libcurl/GCS support, so gs:// paths work given GCS_OAUTH_TOKEN.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        bcftools tabix curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        tsinfer==0.5.0 tsdate==0.2.5 tskit==1.0.1 tszip==0.3.0 \
        cyvcf2==0.35.0 pysam==0.24.1 numpy pandas

COPY scripts/ ./scripts/
CMD ["bash"]
