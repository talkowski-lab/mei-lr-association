## General-purpose bioinformatics environment shared by workflows that just need
## standard command-line tools (samtools, bedtools, minimap2, bcftools, tabix,
## seqtk) rather than a bespoke script-driven pipeline.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        bedtools tabix minimap2 seqtk python3 python3-pip \
        build-essential zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev libncurses-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages biopython

## Build samtools/bcftools from source rather than off the Debian bookworm
## package (1.13): the ExtractSeq task in seq_extract_from_asm.wdl needs
## `samtools consensus --regions-file`, only added in samtools 1.24.
ARG HTS_VERSION=1.24
RUN cd /tmp \
    && for pkg in htslib samtools bcftools; do \
        curl -sSL "https://github.com/samtools/${pkg}/releases/download/${HTS_VERSION}/${pkg}-${HTS_VERSION}.tar.bz2" | tar xj; \
    done \
    && cd /tmp/htslib-${HTS_VERSION} && ./configure --enable-libcurl && make -j"$(nproc)" && make install \
    && cd /tmp/samtools-${HTS_VERSION} && ./configure --with-htslib=system && make -j"$(nproc)" && make install \
    && cd /tmp/bcftools-${HTS_VERSION} && ./configure --with-htslib=system && make -j"$(nproc)" && make install \
    && ldconfig \
    && rm -rf /tmp/htslib-${HTS_VERSION} /tmp/samtools-${HTS_VERSION} /tmp/bcftools-${HTS_VERSION}

## gcloud/gsutil/bq CLIs, for tasks that need to shell out to GCS directly
## (e.g. listing/copying gs:// paths) rather than relying on WDL File/String
## localization alone. Installed via the standalone SDK tarball rather than
## apt's google-cloud-cli package, since that requires setting up Google's apt
## repo/signing key first.
RUN curl -sSL https://sdk.cloud.google.com | bash -s -- --disable-prompts --install-dir=/opt
ENV PATH="/opt/google-cloud-sdk/bin:${PATH}"

## seqkit, for FASTA/FASTQ manipulation tasks (stats, subseq, grep, etc.).
## Installed from the prebuilt release binary (bioinf.shenwei.me/seqkit/download)
## rather than apt, for a pinned, known-good version. /usr/local/bin is already
## on PATH, so no ENV update needed here (unlike the gcloud SDK above).
ARG SEQKIT_VERSION=2.13.0
RUN curl -sSL "https://github.com/shenwei356/seqkit/releases/download/v${SEQKIT_VERSION}/seqkit_linux_amd64.tar.gz" \
    | tar xz -C /usr/local/bin seqkit

CMD ["bash"]
