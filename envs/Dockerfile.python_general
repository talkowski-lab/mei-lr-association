## General-purpose Python environment for scripts/*.py (extract_insertion_methylation.py,
## combine_fastas.py, and other pure-Python scripts). pysam and biopython both ship
## manylinux wheels, so no build toolchain is needed.
FROM python:3.11-slim
RUN pip install --no-cache-dir pysam pandas biopython
COPY scripts/ ./scripts/
CMD ["bash"]
